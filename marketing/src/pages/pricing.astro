---
import Layout from "../layouts/Layout.astro";
import PricingCard from "../components/PricingCard.astro";
---

<Layout title="Pricing — Envelope" description="Envelope is free to start. Upgrade to Pro for sync, shared budgets, and unlimited goals.">
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-12 text-center">
    <p class="inline-block bg-cream-dark text-brown text-xs font-semibold tracking-wider uppercase px-3 py-1 rounded-full mb-4">
      Pricing at launch
    </p>
    <h1 class="text-4xl md:text-5xl font-bold text-brown mb-4">Simple pricing.</h1>
    <p class="text-charcoal/75 max-w-xl mx-auto">
      Start free. Upgrade when you need cloud sync, shared budgets, or unlimited goals.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-2 gap-6">
      <PricingCard
        name="Free"
        price="$0"
        features={[
          "Unlimited envelopes",
          "1 device",
          "Manual transactions",
          "Up to 3 active goals",
          "Local-only storage",
        ]}
        cta="Join waitlist"
        href="/#waitlist"
      />
      <PricingCard
        name="Pro"
        price="$4"
        cadence="month"
        features={[
          "Everything in Free",
          "Encrypted cloud sync",
          "Unlimited devices",
          "Shared budgets",
          "Unlimited goals + APR projections",
          "Recurring transactions",
          "Priority support",
        ]}
        cta="Join waitlist"
        href="/#waitlist"
        featured
      />
    </div>
    <p class="text-center text-xs text-muted mt-8">
      Prices in USD and subject to change before launch. We'll confirm final pricing when the app is available.
    </p>
  </section>
</Layout>
