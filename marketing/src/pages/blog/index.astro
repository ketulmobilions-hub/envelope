---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title="Blog — Envelope" description="Updates, tips, and budgeting writing from the Envelope team.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-12">
    <h1 class="text-4xl md:text-5xl font-bold text-brown mb-4">Blog</h1>
    <p class="text-charcoal/75">
      Updates, tips, and budgeting writing.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-24">
    <ul class="divide-y divide-cream-dark/60">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/blog/${post.id}`} class="block group">
            <time class="text-xs uppercase tracking-wider text-muted">{fmt(post.data.pubDate)}</time>
            <h2 class="text-2xl font-bold text-brown mt-1 group-hover:text-terracotta transition-colors">
              {post.data.title}
            </h2>
            <p class="text-charcoal/75 mt-2">{post.data.description}</p>
          </a>
        </li>
      ))}
      {posts.length === 0 && (
        <li class="py-6 text-muted">No posts yet. Check back soon.</li>
      )}
    </ul>
  </section>
</Layout>
