---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Waitlist from "../components/Waitlist.astro";
---

<Layout>
  <Hero />
  <FeatureGrid />

  <section class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="text-3xl md:text-4xl font-bold text-brown mb-12 text-center">How it works</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="w-10 h-10 rounded-full bg-terracotta text-white font-bold flex items-center justify-center mb-4">1</div>
        <h3 class="font-semibold text-brown mb-2">Add your income</h3>
        <p class="text-sm text-charcoal/75 leading-relaxed">
          Set up your accounts and tell Envelope what comes in each month.
        </p>
      </div>
      <div>
        <div class="w-10 h-10 rounded-full bg-terracotta text-white font-bold flex items-center justify-center mb-4">2</div>
        <h3 class="font-semibold text-brown mb-2">Fill your envelopes</h3>
        <p class="text-sm text-charcoal/75 leading-relaxed">
          Allocate every dollar across categories — groceries, rent, savings, fun money.
        </p>
      </div>
      <div>
        <div class="w-10 h-10 rounded-full bg-terracotta text-white font-bold flex items-center justify-center mb-4">3</div>
        <h3 class="font-semibold text-brown mb-2">Spend with intention</h3>
        <p class="text-sm text-charcoal/75 leading-relaxed">
          Log transactions and watch each envelope. No surprises at month-end.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-brown text-cream">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Be first in line.</h2>
      <p class="text-cream/80 mb-8 max-w-xl mx-auto">
        Envelope is launching soon on iOS, Android, and the web. Join the waitlist and we'll email you the moment it's available.
      </p>
      <Waitlist variant="dark" centered />
    </div>
  </section>
</Layout>
